{
  "permissions": {
    "allow": [
      "Bash(node:*)",
      "Bash(npm search:*)",
      "Bash(npm install:*)",
      "Bash(npm run deploy)",
      "Bash(npx wrangler *)",
      "Bash(curl -s -o /dev/null http://127.0.0.1:*)",
      "WebSearch",
      "WebFetch(domain:developers.cloudflare.com)",
      "PowerShell(Get-NetTCPConnection *)"
    ],
    "deny": [
      "Bash(env)",
      "Bash(printenv:*)",
      "Read(**/.wrangler/config/**)",
      "Read(**/.aws/**)",
      "Read(**/.ssh/**)"
    ]
  }
}
